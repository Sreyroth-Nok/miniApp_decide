# Copy this file to .env and fill it in. Never commit .env.

# From @BotFather. Keep this secret.
BOT_TOKEN=
# Your bot's username, without the @
BOT_USERNAME=
# The short name you chose in BotFather's /newapp
APP_SHORT_NAME=
# Your public HTTPS address, with no trailing slash
PUBLIC_URL=
# Any long random string. Telegram sends it back so the webhook can trust updates.
WEBHOOK_SECRET=

# 1 lets you test in a normal browser with fake users. It also lets anyone sign in
# as anyone, so it must be 0 on any public server, including a tunnel.
DEV_MODE=1
